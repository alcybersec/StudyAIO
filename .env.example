# === Database ===
DATABASE_URL=postgresql+asyncpg://studyaio:studyaio@db:5432/studyaio
DATABASE_URL_SYNC=postgresql://studyaio:studyaio@db:5432/studyaio
POSTGRES_USER=studyaio
POSTGRES_PASSWORD=studyaio
POSTGRES_DB=studyaio
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_RECYCLE=1800        # seconds

# === Redis ===
REDIS_URL=redis://redis:6379/0

# === App ===
# Public origin of the frontend. Used to build links emailed to users (password
# reset), so it must be the URL a browser can reach — not a container hostname.
APP_BASE_URL=http://localhost:3001
DATA_DIR=/app/data
LOG_LEVEL=INFO
# LOG_FORMAT=auto  # "auto" (JSON when not TTY), "json", or "console"

# === Storage Backend ===
# STORAGE_BACKEND=local  # "local" or "s3"
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT_URL=       # For MinIO/LocalStack
# S3_PREFIX=              # Optional key prefix
# CDN_BASE_URL=           # CDN URL for serving files

# === Observability ===
# PROMETHEUS_ENABLED=false

# === AI Backend ===
# Which adapter handles AI calls. Per-user credentials saved in Settings
# override these defaults for that user.
# AGENT_BACKEND=claude_code   # claude_code | anthropic_api | openai | zai | ollama

# --- claude_code (default) ---
CLAUDE_CODE_PATH=claude
CLAUDE_MODEL=opus
# The Claude CLI itself ships inside the API/worker image — nothing to mount.
# Path to ~/.claude directory on host (for credentials + settings)
# CLAUDE_CONFIG_DIR=~/.claude

# --- anthropic_api ---
# ANTHROPIC_API_KEY=          # model comes from CLAUDE_MODEL

# --- openai ---
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o

# --- zai (Z.ai / GLM, OpenAI-compatible) ---
# ZAI_API_KEY=
# ZAI_MODEL=glm-5.3           # e.g. glm-5.3, glm-5.3-flash (cheaper), glm-4.6
# Only set this for a regional or self-hosted endpoint:
# ZAI_BASE_URL=https://api.z.ai/api/paas/v4/

# --- ollama ---
# OLLAMA_BASE_URL=http://ollama:11434
# OLLAMA_MODEL=llama3.2

# === Embeddings ===
# EMBEDDING_BACKEND=sentence_transformers  # sentence_transformers | openai | ollama
# EMBEDDING_MODEL=all-MiniLM-L6-v2
# EMBEDDING_DIMENSIONS=384    # must match the pgvector column; changing it needs a migration
# SEARCH_TOP_K=10

# === Pipeline Tuning ===
CLASSIFICATION_CONFIDENCE_THRESHOLD=0.7
FLASHCARD_COUNT_PER_WEEK=15
QUIZ_QUESTION_COUNT_PER_WEEK=8
CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP_TOKENS=50

# === Security ===
COOKIE_SECURE=false
# Keep this below your edge proxy's request body limit. Cloudflare's free and
# Pro plans cap bodies at 100MB, so a value of 100 makes a large lecture fail
# as an opaque 413 the app never sees. 50 keeps the rejection in the app.
MAX_UPLOAD_SIZE_MB=100
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
RATE_LIMIT_UPLOADS=10/minute
RATE_LIMIT_QA=20/minute
# OPENAPI_ENABLED=true  # Set to false in production to disable /docs

# === Authentication ===
JWT_SECRET_KEY=changeme-in-production-use-a-real-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
SELF_HOSTED=true

# Who may create an account:
#   open   — anyone with the URL (default)
#   invite — a valid invite code is required; mint them at POST /api/admin/invites
#   closed — nobody; existing users can still sign in
# Use `invite` for a closed beta.
REGISTRATION_MODE=open

# === Tier limits & cost guards ===
# 0 means unlimited. Pipeline AI calls count toward *_MAX_AI_CALLS_PER_DAY:
# one upload costs about 4 calls (classify + summarize + flashcards + quiz).
# FREE_MAX_COURSES=1
# FREE_MAX_UPLOADS_PER_MONTH=5
# FREE_MAX_AI_CALLS_PER_DAY=100
# PRO_MAX_COURSES=0
# PRO_MAX_UPLOADS_PER_MONTH=0
# PRO_MAX_AI_CALLS_PER_DAY=0
#
# Instance-wide daily ceiling: the only thing that bounds your total bill, since
# N users times their individual limits is unbounded in aggregate. Applies to
# every tier and in self-hosted mode. 0 disables. Resets at 00:00 UTC.
# GLOBAL_MAX_AI_CALLS_PER_DAY=0
# GLOBAL_MAX_AI_TOKENS_PER_DAY=0

# === Error monitoring (optional) ===
# Leave SENTRY_DSN empty to disable Sentry entirely (API, worker and UI).
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.0
# SENTRY_RELEASE=
# Frontend equivalents — these are read at BUILD time, not runtime.
# VITE_SENTRY_DSN=
# VITE_SENTRY_ENVIRONMENT=production
# VITE_SENTRY_RELEASE=
# VITE_SENTRY_TRACES_SAMPLE_RATE=0

# === Notifications (optional) ===
# NOTIFICATIONS_ENABLED=false
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=studyaio@example.com
# SMTP_FROM_NAME=StudyAIO
# SMTP_USE_TLS=true
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_URL=

# === OAuth (optional) ===
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# === Backups (optional) ===
# BACKUP_ENABLED=false
# BACKUP_SCHEDULE_HOUR=2      # UTC hour for the nightly pg_dump
# BACKUP_RETENTION=7          # dumps to keep

# === Demo mode (optional) ===
# DEMO_ENABLED=false          # enables GET /api/auth/demo-login; needs a seeded demo user

# === OAuth redirect (SaaS) ===
# OAUTH_REDIRECT_BASE_URL=    # e.g. https://app.example.com — defaults to http://localhost:8000
# GOOGLE_CALENDAR_SCOPES=https://www.googleapis.com/auth/calendar

# === Billing (optional, SaaS only) ===
# STRIPE_API_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRO_PRICE_ID=
# STRIPE_PORTAL_RETURN_URL=http://localhost:3001/settings

# === Web Push (optional) ===
# Generate a keypair with: python scripts/generate_vapid_keys.py
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_ADMIN_EMAIL=admin@studyaio.local
