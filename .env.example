# === Database ===
DATABASE_URL=postgresql+asyncpg://studyaio:studyaio@db:5432/studyaio
DATABASE_URL_SYNC=postgresql://studyaio:studyaio@db:5432/studyaio
POSTGRES_USER=studyaio
POSTGRES_PASSWORD=studyaio
POSTGRES_DB=studyaio

# === Redis ===
REDIS_URL=redis://redis:6379/0

# === App ===
DATA_DIR=/app/data
LOG_LEVEL=INFO

# === Storage Backend ===
# STORAGE_BACKEND=local  # "local" or "s3"
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT_URL=       # For MinIO/LocalStack
# S3_PREFIX=              # Optional key prefix
# CDN_BASE_URL=           # CDN URL for serving files

# === Observability ===
# PROMETHEUS_ENABLED=false

# === Claude Code ===
CLAUDE_CODE_PATH=claude
CLAUDE_MODEL=opus
# Path to Claude CLI binary on host (mounted into worker container)
# CLAUDE_CLI_PATH=~/.local/bin/claude
# Path to ~/.claude directory on host (for credentials + settings)
# CLAUDE_CONFIG_DIR=~/.claude

# === Pipeline Tuning ===
CLASSIFICATION_CONFIDENCE_THRESHOLD=0.7
FLASHCARD_COUNT_PER_WEEK=15
QUIZ_QUESTION_COUNT_PER_WEEK=8
CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP_TOKENS=50

# === Security ===
MAX_UPLOAD_SIZE_MB=100
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
RATE_LIMIT_UPLOADS=10/minute
RATE_LIMIT_QA=20/minute

# === Authentication ===
JWT_SECRET_KEY=changeme-in-production-use-a-real-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
SELF_HOSTED=true

# === Notifications (optional) ===
# NOTIFICATIONS_ENABLED=false
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=studyaio@example.com
# SMTP_FROM_NAME=StudyAIO
# SMTP_USE_TLS=true
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_URL=

# === OAuth (optional) ===
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
